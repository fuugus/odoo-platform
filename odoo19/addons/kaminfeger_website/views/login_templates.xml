<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_external_text_kf" inherit_id="website.login_layout" name="KF Theme - Login External Text">
        <xpath expr="//div[hasclass('oe_website_login_container')]" position="before">
            <div class="container text-center mb-5 mt-5">
                <h2 class="font-weight-bold">Anmeldung Mitgliederbereich</h2>
                <p class="text-muted">Melden Sie sich jetzt an, um auf den Mitgliederbereich zuzugreifen.</p>
            </div>
        </xpath>
    </template>
</odoo>