<odoo>
    <data>
        <record id="kaminfeger_styles_404" model="ir.asset">
            <field name="name">404 CSS</field>
            <field name="bundle">kaminfeger_website.kf_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/kaminfeger/404.scss</field>
        </record>

        <record id="kaminfeger_styles_blog" model="ir.asset">
            <field name="name">Blog CSS</field>
            <field name="bundle">kaminfeger_website.kf_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/kaminfeger/blog.scss</field>
        </record>

        <record id="kaminfeger_styles_font" model="ir.asset">
            <field name="name">Font CSS</field>
            <field name="bundle">kaminfeger_website.kf_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/kaminfeger/font.scss</field>
        </record>

        <record id="kaminfeger_styles_footer" model="ir.asset">
            <field name="name">Footer CSS</field>
            <field name="bundle">kaminfeger_website.kf_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/kaminfeger/footer.scss</field>
        </record>

        <record id="kaminfeger_styles_forms" model="ir.asset">
            <field name="name">Forms CSS</field>
            <field name="bundle">kaminfeger_website.kf_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/kaminfeger/forms.scss</field>
        </record>

        <record id="kaminfeger_styles_header" model="ir.asset">
            <field name="name">Header CSS</field>
            <field name="bundle">kaminfeger_website.kf_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/kaminfeger/header.scss</field>
        </record>

        <record id="kaminfeger_styles_login" model="ir.asset">
            <field name="name">Login CSS</field>
            <field name="bundle">kaminfeger_website.kf_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/kaminfeger/login.scss</field>
        </record>

        <record id="kaminfeger_styles_shop" model="ir.asset">
            <field name="name">Shop CSS</field>
            <field name="bundle">kaminfeger_website.kf_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/kaminfeger/shop.scss</field>
        </record>

        <record id="assets_frontend_kaminfeger_link" model="ir.asset">
            <field name="name">Link Kaminfeger Bundle</field>
            <field name="bundle">web.assets_frontend</field>
            <field name="directive">include</field>
            <field name="path">kaminfeger_website.kf_bundle</field>
            
            <field name="website_id" ref="website.default_website"/>
        </record>



        <record id="feuko_styles_forms" model="ir.asset">
            <field name="name">Feuko Forms CSS</field>
            <field name="bundle">kaminfeger_website.feuko_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/feuko/forms.scss</field>
        </record>

        <record id="feuko_styles_header" model="ir.asset">
            <field name="name">Feuko Header CSS</field>
            <field name="bundle">kaminfeger_website.feuko_bundle</field>
            <field name="path">kaminfeger_website/static/src/scss/feuko/header.scss</field>
        </record>

        <record id="assets_frontend_feuko_link" model="ir.asset">
            <field name="name">Link Feuko Bundle</field>
            <field name="bundle">web.assets_frontend</field>
            <field name="directive">include</field>
            <field name="path">kaminfeger_website.feuko_bundle</field>
            
            <field name="website_id" eval="2"/>
        </record>
    </data>
</odoo>