<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="Kaminfeger - Snippets">

    <!-- Create the snippets group -->
    <xpath expr="//snippets[@id='snippet_groups']/*[1]" position="before">
        <t snippet-group="kaminfeger" t-snippet="website.s_snippet_group" string="Kaminfeger" t-thumbnail="/kaminfeger_website/static/src/img/wbuilder/s_kftheme_group_thumbnail.png"/>
    </xpath>

