<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_snippet_kfteam" name="Kaminfeger Team Snippet">
        <section class="s_snippet_kfteam">
            
            <style>
                .kfteam-member {
                    position: relative;
                    overflow: hidden;
                }

                .kfteam-img-container {
                    position: relative;
                    width: 100%;
                    z-index: 1;
                }

                .kfteam-img {
                    width: 100%;
                    height: 100%;
                    background-position: center center;
                    background-size: cover;
                    background-repeat: no-repeat;
                }

                .kfteam-img-hover {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background-position: center center;
                    background-size: cover;
                    background-repeat: no-repeat;
                    opacity: 0;
                    z-index: 2;
                    transition: opacity 0.4s ease-in-out;
                }

                .kfteam-overlay {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 10;
                    display: flex;
                    flex-direction: column;
                    justify-content: flex-end;
                    padding: 20px;
                    pointer-events: none;
                }
                
                .kfteam-contact a {
                    pointer-events: auto; 
                }

                .kfteam-overlay-bg {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0,0,0,0.8);
                    transition: background 0.4s ease-in-out;
                    z-index: -1;
                }

                .kfteam-member:hover .kfteam-img-hover {
                    opacity: 1;
                }

                .kfteam-member:hover .kfteam-overlay-bg {
                    background: rgba(0, 0, 0, 0.5); 
                }
                
                .kfteam-info, .kfteam-info h3, .kfteam-info p, .kfteam-contact i {
                    color: #fff;
                    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
                }

            </style>

            <div class="kfteam-wrapper">
                <div class="splide splide-team">
                    <div class="splide__track">
                        <ul class="splide__list">
                            <t t-foreach="request.env['hr.employee'].sudo().search([('active', '=', True)], limit=20)" t-as="employee">
                                <li class="splide__slide">
                                    <div class="kfteam-member">
                                        
                                        <div class="kfteam-img-container">
                                            <t t-set="hover_img" t-value="employee.x_studio_hover_bild"/> 
                                            <div t-if="hover_img" 
                                                 class="kfteam-img-hover"
                                                 t-attf-style="background-image: url('data:image/png;base64,#{hover_img.decode('utf-8') if hover_img else ''}');">
                                            </div>

                                            <div class="kfteam-img"
                                                 t-attf-style="background-image: url('data:image/png;base64,#{employee.image_512.decode('utf-8') if employee.image_512 else ''}');">
                                            </div>
                                        </div>

                                        <div class="kfteam-overlay">
                                            <div class="kfteam-overlay-bg"></div>
                                            
                                            <div class="kfteam-info">
                                                <p><span t-field="employee.job_title"/></p>
                                                <h3><span t-field="employee.name"/></h3>
                                                
                                                <div class="kfteam-contact">
                                                    <a t-if="employee.work_email" 
                                                       t-attf-href="mailto:#{employee.work_email.strip()}" 
                                                       class="kfteam-email"
                                                       style="position: relative; z-index: 20; display: inline-block; padding: 5px;">
                                                        <span style="font-size: 0px; opacity: 0;">Email</span>
                                                        <i class="fa-regular fa-envelope"></i>
                                                    </a>

                                                    <a t-if="employee.work_phone" 
                                                       t-attf-href="tel:#{employee.work_phone.strip()}" 
                                                       class="kfteam-phone"
                                                       style="position: relative; z-index: 20; display: inline-block; padding: 5px;">
                                                        <span style="font-size: 0px; opacity: 0;">Telefon</span>
                                                        <i class="fa-regular fa-phone"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            </t>
                        </ul>
                    </div>
                    <div class="splide__arrows"></div>
                    <ul class="splide__pagination"></ul>
                </div>
            </div>
        </section>
    </template>
</odoo>