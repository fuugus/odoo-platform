<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="template_footer_website_kaminfeger"
        name="Kaminfeger Footer"
        inherit_id="website.layout"
        active="False"
    >
        <div id="footer" position="replace">
        
            <div
                t-if="not no_footer"
                id="footer"
                class="oe_structure oe_structure_solo kffooter"
                t-ignore="true"
            >
                
                <div class="footer-wrapper container">
                    <div class="footer-container">
                        <div class="footer-left">
                            <img src="/kaminfeger_website/static/src/img/content/footer-logo.png" alt="Kaminfeger Logo" class="footer-logo"/>
                            <div class="social-links">
                                <a href="https://www.instagram.com/kaminfegerverband/" target="_blank" class="social-link">
                                    <i class="fa fa-instagram"></i>
                                </a>
                                <a href="https://www.facebook.com/kaminfegerverband" target="_blank" class="social-link">
                                    <i class="fa-brands fa-facebook-f"></i>
                                </a>
                                <a href="https://www.youtube.com/@kaminfegerverband" target="_blank" class="social-link">
                                    <i class="fa fa-youtube"></i>
                                </a>
                            </div>
                        </div>
                        <div class="footer-right">
                            <div class="footer-kontakt">
                                <h3>Kontakt</h3>
                                <p>
                                    Kaminfeger Schweiz<br/>
                                    Renggerstrasse 44<br/>
                                    5000 Aarau<br/>
                                </p>
                                <a href="phone:+41628347666" class="footer-phone">+41 (0) 62 834 76 66</a>
                            </div>

                            <div class="footer-links">
                                <h3>Kunden</h3>
                                <ul>
                                    <li><a href="/shop">Shop</a></li>
                                    <li><a href="/blog">Blog</a></li>
                                    <li><a href="/contactus">Kontakt</a></li>
                                    <li><a href="/privacy-policy">Datenschutz</a></li>
                                </ul>
                            </div>

                            <div class="footer-links">
                                <h3>Ausbildung</h3>
                                <ul>
                                    <li><a href="/training">Lehrstellen</a></li>
                                    <li><a href="/training/courses">Kurse</a></li>
                                    <li><a href="/training/faq">FAQ</a></li>
                                </ul>
                            </div>

                            <div class="footer-links">
                                <h3>Mitglieder</h3>
                                <ul>
                                    <li><a href="/members">Mitgliederbereich</a></li>
                                    <li><a href="/members/association">Vereinsinfos</a></li>
                                    <li><a href="/members/benefits">Vorteile</a></li>
                                </ul>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="o_footer_copyright kfcopyright" data-name="Copyright">
                    <div class="subfooter-container container">
                        <div class="subfooter-left">
                            © 2025 Kaminfeger Schweiz
                        </div>
                        <div class="subfooter-right">
                            <a href="/imprint">Impressum</a>
                            <a href="/privacy-policy">Datenschutz</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </template>
    

</odoo>