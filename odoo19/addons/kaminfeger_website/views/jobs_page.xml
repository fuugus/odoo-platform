<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_jobs_sidebar_layout" inherit_id="website_hr_recruitment.index" name="Jobs Sidebar Layout">
        
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class=" pb-5">
                
                <div class="container pt-5 pb-4">
                    <div class="row text-left">
                        <div class="">
                            <h1 class="font-weight-bold mb-3">Werde Teil unseres Teams</h1>
                            <p class="lead text-muted">
                                Wir suchen Talente, die mit uns wachsen wollen. 
                                Finde hier deinen Traumjob in deiner Region.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="container">
                    <div class="row">
                        
                        <div class="col-lg-3 mb-4">
                            <div class="card border-0 sticky-top" style="top: 100px; z-index: 1;">
                                
                                
                                <form method="get" action="/jobs">
                                    <div class="form-group">
                                        <label class="text-muted small font-weight-bold pb-2">Kanton</label>
                                        <select name="kanton" class="form-control custom-select" onchange="this.form.submit()">
                                            <option value="">Alle Kantone</option>
                                            <t t-foreach="cantons" t-as="c">
                                                <option t-att-value="c.id" t-att-selected="c.id == current_kanton">
                                                    <t t-esc="c.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    
                                    <div t-if="current_kanton" class="mt-3 border-top pt-3">
                                        <a href="/jobs" class="text-danger small font-weight-bold text-decoration-none">
                                            <i class="fa fa-times mr-1"/> Filter zurücksetzen
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="col-lg-9">
                            
                            <t t-if="not jobs">
                                <div class="alert alert-light border-0 shadow-sm py-5 text-center">
                                    <i class="fa fa-search fa-3x text-muted mb-3"/>
                                    <h3>Keine Jobs gefunden</h3>
                                    <p class="text-muted">Versuche den Filter zu ändern.</p>
                                    <a href="/jobs" class="btn btn-primary mt-2">Alle Jobs anzeigen</a>
                                </div>
                            </t>

                            <div class="">
                                <t t-foreach="jobs" t-as="job">
                                    <div class=" mb-4">
                                        <div class="card border-0 bg-grey job-card-custom transition-hover" >
                                            <div class="card-body p-4 d-flex flex-column" style="background-color: #F3F4F6;">
                                                
                                                <h4 class="card-title font-weight-bold ">
                                                    <a t-attf-href="/jobs/detail/#{slug(job)}" class="text-dark text-decoration-none stretched-link">
                                                        <span t-field="job.name"/>, <span t-esc="job.address_id.city"/> <span t-esc="job.address_id.state_id.code"/>
                                                    </a>
                                                </h4>

                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <div class="d-flex justify-content-center mt-4" t-if="pager['page_count'] > 1">
                                <t t-call="website.pager"/>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>