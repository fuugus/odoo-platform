<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_person_search_form" name="Personen Suche Formular (GET)">
        <section class="s_person_search_form pt32 pb32 bg-100">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-4">
                                <h3 class="mb-4 text-center">Person suchen</h3>
                                
                                <form action="/feuko/search" method="GET">
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="vorname" class="form-label">Vorname</label>
                                            <input type="text" class="form-control" name="vorname" 
                                                   t-att-value="search_params.get('vorname') if search_params else ''"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="name" class="form-label">Name</label>
                                            <input type="text" class="form-control" name="name" 
                                                   t-att-value="search_params.get('name') if search_params else ''"/>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="feuko_nr" class="form-label">Feuko-Nummer</label>
                                        <input type="text" class="form-control" name="feuko_nr" 
                                               t-att-value="search_params.get('feuko_nr') if search_params else ''"/>
                                    </div>
                                    
                                    <div class="text-center mt-4">
                                        <button type="submit" class="btn btn-primary px-5">Suchen</button>
                                    </div>
                                </form>
                                </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>