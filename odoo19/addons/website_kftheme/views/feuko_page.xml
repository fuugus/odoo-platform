<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="feuko_page" name="Suchergebnisse">
        <t t-call="website.layout">

            <t t-call="website_kftheme.s_person_search_form"/>

            <div class="container mb-5 mt-5">
                <h3>Suchergebnisse</h3>
                <hr/>

                <div t-if="search_performed and not partners" class="alert alert-info">
                    Keine Ergebnisse für deine Suche gefunden.
                </div>

                <div t-if="not search_performed" class="alert alert-secondary">
                    Bitte gib oben Suchbegriffe ein.
                </div>

                <div t-if="partners" class="row mt-4">
                    <t t-foreach="partners" t-as="partner">
                        <div class="col-md-12 col-lg-12 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body row">
                                    <div class="card-text text-muted col-md-6">
                                        <h5 class="card-title text-primary" t-field="partner.name"/>

                                        <div t-if="partner.x_studio_feuko_nummer">
                                            <strong>Feuko-Nummer:</strong> <span t-field="partner.x_studio_feuko_nummer"/>
                                        </div>
                                        <div t-if="partner.x_studio_heimatort">
                                            <strong>Heimatort:</strong> <span t-field="partner.x_studio_heimatort"/>
                                        </div>
                                        <div t-if="partner.x_studio_geburtsdatum">
                                            <strong>Geburtsjahr:</strong> <span t-field="partner.x_studio_geburtsdatum" t-options="{'widget': 'date', 'format': 'yyyy'}" />
                                        </div>
                                    </div>

                                    <div class="col-md-6  text-start">
                                        <strong>Abschlüsse:</strong>
                                        <div>
                                            <t t-foreach="abschluesse" t-as="abschluss">
                                                <div t-if="abschluss">
                                                    <i t-if="abschluss in partner.x_studio_abschlusse" class="fa fa-check-circle text-success me-1"/>
                                                    <i t-if="not abschluss in partner.x_studio_abschlusse" class="fa fa-circle text-muted me-1"/>
                                                    <span t-field="abschluss.x_name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
