<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_blog_index_sidebar" inherit_id="website_blog.index" name="KF Theme - Blog Index with Sidebar">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div class="js_blog website_blog" id="wrap">
                <div class="container mt-4">
                    <div class="row">
                        <aside class="col-lg-3 d-none d-lg-block">
                            <div class="sticky-top pt-4" style="top: 100px;">
                                <div class="mb-4">
                                    <h3 class="mb-2">
                                        Links
                                    </h3>
                                    <div class="mb-2">
                                        Für weitere Informationen über Uhren empfehlen wir folgende Quellen
                                    </div>
                                    <div class="mb-2">
                                        <a href="" target="_blank">Deutsches Uhrenmuseum</a><br/>
                                        <a href="" target="_blank">International Watch Company</a><br/>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h3 class="mb-2">
                                        Downloads
                                    </h3>
                                    <div class="mb-2">
                                        Für weitere Informationen über Uhren empfehlen wir folgende Quellen
                                    </div>
                                    <div class="mb-2">
                                        <a href="" target="_blank">Download</a><br/>
                                        <a href="" target="_blank">Download</a><br/>
                                    </div>
                                </div>
                            </div>
                        </aside>

                        <main t-attf-class="col-lg-9 #{'col-12' if not blog_post else ''}">
                            <t t-out="0"/>
                        </main>
                    </div>
                </div>
            </div>
        </xpath>
    </template>


</odoo>