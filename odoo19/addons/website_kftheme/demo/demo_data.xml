<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TOP Menu Items -->
    <record id="my_submenu_1" model="website.menu">
        <field name="name">Kontakt</field>
        <field name="parent_id" ref="website_kftheme.my_header_menu"/>
