    <record id="odoo_studio_hr_emplo_4f2afd2d-88b9-4b14-9077-0b878c8dcbd0" model="ir.ui.view">
        <field name="name">Odoo Studio: hr.employee.form customization</field>
        <field name="model">hr.employee</field>
        <field name="type">form</field>
        <field name="priority">10000</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <data>
                                                                                                                                                                                                  <xpath expr="/form//field[@name='name']" position="after">
                                                                                                                                                                                                    <field name="x_studio_hover_bild" widget="image" class="oe_avatar ml-3 h4"/>
                                                                                                                                                                                                  </xpath>
                                                                                                                                                                                                  <xpath expr="/form//field[@name='parent_id']" position="after">
                                                                                                                                                                                                    <field widget="image" name="x_studio_hover_bild" invisible="True"/>
                                                                                                                                                                                                  </xpath>
                                                                                                                                                                                                </data>
        </field>
    </record>

