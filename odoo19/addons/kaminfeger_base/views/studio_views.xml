    <record id="odoo_studio_res_part_6b0631b0-2f44-4d2e-8d5e-7d6331c11c30" model="ir.ui.view">
        <field name="name">Odoo Studio: res.partner.form customization</field>
        <field name="model">res.partner</field>
        <field name="type">form</field>
        <field name="priority">360</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <data>
                                                                                                                                                                                                  <xpath expr="/form//page[@name='internal_notes']" position="after">
                                                                                                                                                                                                    <page string="Kaminfeger" name="studio_page_lr_1jf3hc9ev" invisible="False">
                                                                                                                                                                                                      <group name="studio_group_lr">
                                                                                                                                                                                                        <group name="studio_group_lr_left">
                                                                                                                                                                                                          <field name="x_studio_feuko_nummer" invisible="company_type == &quot;company&quot;"/>
                                                                                                                                                                                                          <field name="x_studio_mitgliedernummer" options="{&quot;enable_formatting&quot;:false}"/>
                                                                                                                                                                                                          <field name="x_studio_mitgliedstatus"/>
                                                                                                                                                                                                          <field name="x_studio_ist_kaminfeger_unternehmen" invisible="company_type == &quot;person&quot;"/>
                                                                                                                                                                                                          <field name="x_studio_ist_lehrbetrieb" invisible="company_type == &quot;person&quot;"/>
                                                                                                                                                                                                          <field name="x_studio_ist_lehrling" invisible="company_type == &quot;company&quot;"/>
                                                                                                                                                                                                          <field name="x_studio_lehrstart" invisible="company_type == &quot;company&quot; or not x_studio_ist_lehrling"/>
                                                                                                                                                                                                          <field name="x_studio_status_lehre" invisible="company_type == &quot;company&quot; or not x_studio_ist_lehrling"/>
                                                                                                                                                                                                          <field name="x_studio_geburtsdatum" invisible="company_type == &quot;company&quot;" options="{&quot;warn_future&quot;:true}"/>
                                                                                                                                                                                                          <field name="x_studio_heimatort" invisible="company_type == &quot;company&quot;"/>
                                                                                                                                                                                                          <field name="x_studio_abschlusse" invisible="company_type == &quot;company&quot;"/>
                                                                                                                                                                                                        </group>
                                                                                                                                                                                                        <group name="studio_group_lr_right"/>
                                                                                                                                                                                                      </group>
                                                                                                                                                                                                    </page>
                                                                                                                                                                                                  </xpath>
                                                                                                                                                                                                </data>
        </field>
    </record>

